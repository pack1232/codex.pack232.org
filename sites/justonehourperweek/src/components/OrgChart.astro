---
/**
 * OrgChart — Renders the organization chart from _data/org-chart.yml
 * Generates a Mermaid flowchart diagram.
 */
import fs from 'node:fs';
import path from 'node:path';

const orgChartPath = path.resolve('../../_data/org-chart.yml');
// The org chart is rendered via the org-chart.md content page which
// already contains the mermaid diagram. This component provides a
// reusable wrapper if needed elsewhere.
---

<div class="org-chart">
  <slot />
</div>
