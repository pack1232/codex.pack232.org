---
/**
 * RoleTasks — Replaces {% include role-tasks.html role_id=... %}
 * Displays tasks associated with a given role_id.
 */
import { getCollection } from 'astro:content';

interface Props {
  roleId: string;
}

const { roleId } = Astro.props;

const allTasks = await getCollection('docs', (entry) => {
  return entry.data.task_id && (
    entry.data.owner === roleId ||
    (entry.data.roles && entry.data.roles.includes(roleId))
  );
});

// Sort: owned tasks first, then involved
const owned = allTasks.filter((t) => t.data.owner === roleId);
const involved = allTasks.filter((t) => t.data.owner !== roleId);
---

{allTasks.length > 0 && (
  <section class="role-tasks">
    <h2>Tasks</h2>
    {owned.length > 0 && (
      <>
        <h3>Owned Tasks</h3>
        <table>
          <thead>
            <tr><th>Task</th><th>Category</th><th>Frequency</th></tr>
          </thead>
          <tbody>
            {owned.map((task) => (
              <tr>
                <td><a href={`/${task.id}/`}>{task.data.title}</a></td>
                <td>{task.data.category}</td>
                <td>{task.data.frequency}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )}
    {involved.length > 0 && (
      <>
        <h3>Involved Tasks</h3>
        <table>
          <thead>
            <tr><th>Task</th><th>Category</th><th>Owner</th><th>Frequency</th></tr>
          </thead>
          <tbody>
            {involved.map((task) => (
              <tr>
                <td><a href={`/${task.id}/`}>{task.data.title}</a></td>
                <td>{task.data.category}</td>
                <td>{task.data.owner}</td>
                <td>{task.data.frequency}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )}
  </section>
)}
