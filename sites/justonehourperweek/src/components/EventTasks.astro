---
/**
 * EventTasks — Replaces {% include event-tasks.html event_id=... %}
 * Displays tasks associated with a given event.
 */
import { getCollection } from 'astro:content';

interface Props {
  eventId: string;
}

const { eventId } = Astro.props;

const allTasks = await getCollection('docs', (entry) => {
  return entry.data.task_id && entry.data.tags?.includes(eventId);
});
---

{allTasks.length > 0 && (
  <section class="event-tasks">
    <h2>Related Tasks</h2>
    <table>
      <thead>
        <tr><th>Task</th><th>Owner</th><th>Frequency</th></tr>
      </thead>
      <tbody>
        {allTasks.map((task) => (
          <tr>
            <td><a href={`/${task.id}/`}>{task.data.title}</a></td>
            <td>{task.data.owner}</td>
            <td>{task.data.frequency}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
)}
